# ── DATABASE ──────────────────────────────────────────────────────────────
# انسخ الـ Connection String من Neon أو Supabase (Pooled connection, sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT SECRET ────────────────────────────────────────────────────────────
# غيّر الكلمة دي لأي كلمة سرية طويلة وعشوائية — Render بيولّدها تلقائياً لو مستخدم render.yaml
JWT_SECRET=change_this_to_a_long_random_secret

# ── SERVER ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-app.onrender.com

# ── ANTHROPIC AI (اختياري) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── MICROSOFT GRAPH (Outlook / Calendar / OneDrive / Power Automate) ──────
# اختياري — بدونها التكاملات دي مش هتشتغل بس باقي النظام شغال عادي.
# سجّل App Registration جديد على https://portal.azure.com → Azure Active Directory → App registrations
# الصلاحيات المطلوبة (API permissions): Mail.Send, Calendars.ReadWrite, Files.ReadWrite, User.Read, offline_access
# Redirect URI (Web) لازم يطابق MS_REDIRECT_URI بالظبط
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=https://your-app.onrender.com/api/integrations/msgraph/callback
